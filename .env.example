# ---- MyTavern ----
PORT=3000
# 公网部署必填；设置后访问需要输入该口令
ACCESS_TOKEN=

# ---- 安全（公网部署建议）----
# 允许跨域来源，逗号分隔；留空 = 允许任意来源
CORS_ORIGIN=
# 全 HTTPS 部署时设为 1：Cookie 加 Secure 并使用 __Host- 前缀
COOKIE_SECURE=
# 登录限流：窗口内允许的最大失败次数（0 关闭）
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000
# 不需要本地模型（Ollama/LM Studio）时设为 false，禁止请求发往私网地址（防 SSRF）
ALLOW_PRIVATE_BASE_URLS=true

# ---- 运行时（可选）----
# 出站模型请求超时（毫秒）
OUTBOUND_TIMEOUT_MS=120000
# 并发生成上限
MAX_CONCURRENT_GENERATIONS=8

# OpenAI 兼容服务 Key（可选，启动时自动生成对应连接预设）
DEEPSEEK_API_KEY=
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
SILICONFLOW_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
GITHUB_TOKEN=
